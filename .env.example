# Vercel AI Gateway（https://vercel.com/docs/ai-gateway）
# 在 Vercel 控制台创建 AI Gateway API Key；或在已 vercel link 的项目里用
# `vercel env pull` 获取 VERCEL_OIDC_TOKEN（二选一，AI_GATEWAY_API_KEY 优先）
AI_GATEWAY_API_KEY=
# 模型用 "provider/model" 格式，改这一行即可切换任意模型（注意版本号用点）
# 例如：anthropic/claude-sonnet-5 / openai/gpt-5.4 / google/gemini-3-flash
LLM_MODEL=anthropic/claude-sonnet-5
# 轻量任务模型（求助问答/归档翻译/术语卡干扰项），同样经 AI Gateway
LLM_LITE_MODEL=google/gemini-3-flash
DATABASE_PATH=data/app.db
OBSIDIAN_VAULT_PATH=
